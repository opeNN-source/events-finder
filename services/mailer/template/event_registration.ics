BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Event Finder//Mail Service//EN
METHOD:REQUEST
BEGIN:VTIMEZONE
TZID:Europe/Moscow
BEGIN:STANDARD
TZOFFSETFROM:+0300
TZOFFSETTO:+0300
TZNAME:MSK
DTSTART:19700101T000000
END:STANDARD
END:VTIMEZONE

BEGIN:VEVENT
UID:{{.Id}}@event-finder.ru
DTSTAMP:{{.CreateTime}}
DTSTART;TZID=Europe/Moscow:{{.StartTime}}
DTEND;TZID=Europe/Moscow:{{.EndTime}}
SUMMARY:{{.Name}}
DESCRIPTION:{{.Description}}
LOCATION:{{.Region}}
END:VEVENT
END:VCALENDAR