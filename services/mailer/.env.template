# === App ===
APP_NAME="mail_sender"
APP_VERSION="1.0.0"

# === Logger Config ===
# Уровень логирования: debug, info, warning, error, critical
LOGGER_LEVEL="info"

# Включить запись логов в файл (true/false)
FILE_LOGGER="false"

# === SMTP Config ===
# Хост SMTP-сервера
SMTP_HOST="smtp.gmail.com"

# Порт SMTP (587 — для STARTTLS, 465 — для SSL, 25 — обычный)
SMTP_PORT=587

# Логин от почтового ящика
SMTP_USERNAME="your_email@gmail.com"

# Пароль или App Password (для Gmail рекомендуется использовать App Password)
SMTP_PASSWORD="your_app_password"

# Адрес отправителя (может совпадать с SMTP_USERNAME)
SMTP_FROM="no-reply@example.com"

# Имя отправителя, которое будет отображаться получателю
SMTP_FROM_NAME="Event Finder"

# Использовать STARTTLS (true/false). Для Gmail — true
SMTP_USE_TLS="true"

# Таймаут на чтение/запись (примеры: 1s, 500ms, 30s)
SMTP_TIMEOUT="30s"

# Таймаут на установку соединения
SMTP_DIAL_TIMEOUT="10s"

# Количество попыток повторной отправки при временной ошибке
SMTP_RETRY=3

# Размер очереди задач на отправку писем
SMTP_JOBS_QUEUE_SIZE=50

# Количество воркеров, обрабатывающих очередь отправки
SMTP_WORKER_COUNT=5

# === gRPC Config ===
# Хост для gRPC-сервера
GRPC_HOST="0.0.0.0"

# Порт для gRPC-сервера
GRPC_PORT="50051"

# Включить TLS для gRPC (true/false)
GRPC_ENABLE_TLS="false"

# Путь к сертификату (требуется, если GRPC_ENABLE_TLS=true)
GRPC_CERT_FILE="certs/server.crt"

# Путь к приватному ключу (требуется, если GRPC_ENABLE_TLS=true)
GRPC_KEY_FILE="certs/server.key"

# === Дополнительно (опционально) ===
# Если планируете добавлять другие сервисы позже, можно оставить место
# DATABASE_URL="postgresql://user:password@localhost:5432/mail_sender"
# REDIS_URL="redis://localhost:6379/0"